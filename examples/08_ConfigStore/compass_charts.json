  {
    "id": "a31a6d19-e388-45d3-aec5-1975a32cdd5d",
    "title": "New Chart",
    "sql": "SELECT\n  u.thread_id,\n  datetime(u.created_at, 'unixepoch') AS asked_at,\n  u.text                              AS user_message,\n  a.text                              AS assistant_answer,\n  round(a.created_at - u.created_at, 1) AS response_time_s\nFROM messages u\nJOIN messages a\n  ON  a.thread_id = u.thread_id\n  AND a.role      = 'assistant'\n  AND a.created_at = (\n        SELECT MIN(created_at)\n        FROM   messages\n        WHERE  thread_id = u.thread_id\n          AND  role      = 'assistant'\n          AND  created_at > u.created_at\n      )\nWHERE u.role = 'user'\nORDER BY u.created_at DESC\nLIMIT 100",
    "chart_type": "table",
    "x_column": "thread_id",
    "y_columns": [
      "asked_at"
    ],
