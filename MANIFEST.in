# Include important files
include README.md
include LICENSE
include requirements.txt
include setup.py

# Include all files in the docs directory
recursive-include docs *

# Include tests
recursive-include tests *

# Include all data files in a specific package directory
recursive-include llamphouse *

# Include example scripts
recursive-include examples *

# Exclude unwanted files
global-exclude *.py[cod]
prune **/__pycache__

# App sources (and their node_modules): the built apps ship in static/
prune llamphouse/llamphouse/runtime/compass/frontend
prune llamphouse/llamphouse/core/adapters/compass/frontend
